ALLOWED_INACTIVITY_MS=10000
APP_BUNDLE_ID="org.example.app"
APPLE_ID="example@example.org"
APPLE_CODESIGN_IDENTITY="Apple Distribution: ... (...)"
APPLE_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: ... (...)"
ASSETS_FOLDER=src/assets/rtr
CERTIFIED_TEST_INTERVAL=15
CERTIFIED_TEST_COUNT=8
CMS_URL=https://example.com
CONTROL_SERVER_URL=https://example.com
CPU_WARNING_PERCENT=80
ENABLE_LANGUAGE_SWITCH=true
ENABLE_HOME_SCREEN_JITTER_BOX=false
EXCLUDE_MENU_ITEMS="Certified,Loop Mode"
FLAVOR=rtr
FULL_HISTORY_RESULT_URL=https://example.org/$lang/Verlauf?
FULL_STATISTICS_URL=https://example.org/$lang/Statistik
FULL_MAP_URL=https://example.org/$lang/Karte
HISTORY_PATH=/history
HISTORY_RESULT_PATH=/measurementResult
HISTORY_RESULTS_LIMIT=50
LOG_CPU_USAGE=true
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_WORKERS=false
LOOP_MODE_MIN_INTERVAL=5
LOOP_MODE_MAX_INTERVAL=120
LOOP_MODE_DEFAULT_INTERVAL=10
LOOP_MODE_MAX_DURATION=2880
MEASUREMENT_SERVERS_PATH=/measurementServer
MESUREMENT_REGISTRATION_PATH=/adminTestRequest
NEWS_PATH=/news
OPEN_HISTORY_RESULT_URL=https://example.org/$lang/Opentest?
PLATFORM_CLI=NODEJS
RESULT_SUBMISSION_PATH=/measurementResult
SETTINGS_PATH=/settings
WINDOWS_CERT_PATH="C:\\Users\\user\\AppData\\Roaming\\electron-windows-store\\developmentca\\developmentca.pfx"
WINDOWS_CERT_PASS=""
# Windows SDK bin dir with makeappx.exe / signtool.exe (required for the MSIX build)
WINDOWS_KITS_PATH="C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.19041.0\\x64"
# Microsoft Store (MSIX) identity — from Partner Center > Product > Product identity.
# The signing certificate's subject must equal MSIX_PUBLISHER.
MSIX_PACKAGE_NAME="ExamplePublisher.ExampleAppIdentityName"
MSIX_PUBLISHER="CN=00000000-0000-0000-0000-000000000000"
MSIX_PUBLISHER_DISPLAY_NAME="Example Publisher Display Name"
MSIX_PACKAGE_DISPLAY_NAME="Example Reserved App Name"
MSIX_MIN_OS_VERSION="10.0.17763.0"
# MSIX signing cert (subject must equal MSIX_PUBLISHER); the Store re-signs.
MSIX_CERT_PATH="msix-dev.pfx"
MSIX_CERT_PASS=""
PACK_NAME="example-pack-name"
PACK_PRODUCT_NAME="Example Product Name"
PACK_DESCRIPTION="Example Description"
PACK_AUTHOR="Example Author"
CHECK_IP_INTERVAL_MS=10000
